<?xml version="1.0" encoding="utf-8" ?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
<_locDefinition xmlns="urn:locstudio">
    <_locDefault _loc="locNone" />
    <_locTag _loc="locData">Title</_locTag>
    <_locTag _loc="locData">Description</_locTag>
    <_locTag _loc="locData">Author</_locTag>
    <_locTag _loc="locData">ToolTip</_locTag>
</_locDefinition>
	<CodeSnippet Format="1.0.0">
	<Header>
	<Title>Get a Work Order</Title>
        <Shortcut></Shortcut>
	<Description>Retrieves the details of a work order including main record, stage records, inputs, input line details, outputs, and output line details.</Description>
	<Author>Jiwa Financials</Author>
	<SnippetTypes>
		<SnippetType>Expansion</SnippetType>
	</SnippetTypes>
	</Header>
	<Snippet>
		<Declarations>
			<Literal>
				<ID>WorkOrderNo</ID>
				<ToolTip>Work order no. of the work order</ToolTip>
				<Default>037</Default>
			</Literal>
		</Declarations>
		<Code Language="SQL">
			<![CDATA[SELECT * FROM BM_WorkOrder WHERE WorkOrderNo = '$WorkOrderNo$'
GO

SELECT BM_WorkOrderStages.*
FROM BM_WorkOrderStages
JOIN BM_WorkOrder ON BM_WorkOrderStages.BM_WorkOrder_RecID = BM_WorkOrder.RecID
WHERE BM_WorkOrder.WorkOrderNo = '$WorkOrderNo$';
GO

SELECT BM_WorkOrderInputs.*
FROM BM_WorkOrderInputs
JOIN BM_WorkOrderStages ON BM_WorkOrderInputs.BM_WorkOrderStages_RecID = BM_WorkOrderStages.RecID
JOIN BM_WorkOrder ON BM_WorkOrderStages.BM_WorkOrder_RecID = BM_WorkOrder.RecID
WHERE BM_WorkOrder.WorkOrderNo = '$WorkOrderNo$';
GO

SELECT BM_WorkOrderInputDetails.*
FROM BM_WorkOrderInputDetails
JOIN BM_WorkOrderInputs ON BM_WorkOrderInputDetails.Parent_RecID = BM_WorkOrderInputs.RecID
JOIN BM_WorkOrderStages ON BM_WorkOrderInputs.BM_WorkOrderStages_RecID = BM_WorkOrderStages.RecID
JOIN BM_WorkOrder ON BM_WorkOrderStages.BM_WorkOrder_RecID = BM_WorkOrder.RecID
WHERE BM_WorkOrder.WorkOrderNo = '$WorkOrderNo$'
ORDER BY BM_WorkOrderInputs.ItemNo;
GO

SELECT BM_WorkOrderOutputs.*
FROM BM_WorkOrderOutputs
JOIN BM_WorkOrder ON BM_WorkOrderOutputs.BM_WorkOrder_RecID = BM_WorkOrder.RecID
WHERE BM_WorkOrder.WorkOrderNo = '$WorkOrderNo$';
GO

SELECT BM_WorkOrderOutputDetails.*
FROM BM_WorkOrderOutputDetails
JOIN BM_WorkOrderOutputs ON BM_WorkOrderOutputDetails.Parent_RecID = BM_WorkOrderOutputs.RecID
JOIN BM_WorkOrder ON BM_WorkOrderOutputs.BM_WorkOrder_RecID = BM_WorkOrder.RecID
WHERE BM_WorkOrder.WorkOrderNo = '$WorkOrderNo$'
ORDER BY BM_WorkOrderOutputs.ItemNo;
GO]]>
		</Code>
	</Snippet>
	</CodeSnippet>
</CodeSnippets>

